---
import '../styles/global.css';
import { Code } from 'astro:components';
import ThemeMenu from '../components/ThemeMenu';
import CopyButton from '../components/CopyButton';
import quickStart from '../../../examples/hello.rs?raw';
const asset = (path: string) => `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${path}`;
const repo = 'https://github.com/huacnlee/gpui-omarchy';
const dependencies = `[dependencies]
gpui-omarchy = "0.1.0"
gpui-base = "=0.6.0"
gpui = { package = "gpui-pre", version = "=0.3.1" }

[dependencies.gpui_platform]
package = "gpui-pre-platform"
version = "=0.3.1"
features = [
  "font-kit", "x11", "wayland",
  "runtime_shaders",
]`;
---
<!doctype html>
<html lang="en" data-theme="tokyo-night">
  <head>
    <meta charset="UTF-8" />
    <style is:inline set:html={`@font-face{font-family:"Omarchy Display";src:url("${asset('fonts/omarchy.ttf')}") format("truetype");font-weight:400;font-style:normal;font-display:swap;}`} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="A gpui-kit component library designed for Omarchy. Native Rust components, system themes, and the freedom of gpui-base." />
    <title>GPUI Omarchy — Native components built on gpui-base.</title>
    <script is:inline>
      try { const theme=localStorage.getItem('gpui-omarchy-theme'); if(['tokyo-night','flexoki-light','catppuccin'].includes(theme)) document.documentElement.dataset.theme=theme; } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header"><div class="shell">
      <a class="site-name" href="#main">GPUI Omarchy</a>
      <nav class="site-nav" aria-label="Main navigation">
        <a href="#components" class="desktop-link">Components</a>
        <a href="#start" class="desktop-link">Get started</a>
        <a href={repo}>GitHub</a>
        <ThemeMenu client:load />
      </nav>
    </div></header>
    <main id="main" class="shell">
      <section class="hero" aria-labelledby="hero-title">
        <h1 id="hero-title" class="hero-brand">GPUI / OMARCHY</h1>
        <p class="lead">Native <a class="text-link" href="https://gpui-kit.com/base/">gpui-base</a> components for Omarchy.<br />Part of <a class="text-link" href="https://gpui-kit.com/">GPUI Kit</a>. Guided by <a class="text-link" href="https://github.com/huacnlee/omarchy-style">Omarchy Style</a>.</p>
        <div class="actions"><a class="button primary" href="#start">Build with Omarchy</a><a class="button" href="#components">Explore components</a></div>
        <p class="hero-note">Rust + GPUI · Open source · MIT licensed</p>
      </section>
      <section id="components" class="live-gallery" aria-label="Live GPUI Omarchy gallery">
        <iframe src={asset('gallery/index.html')} title="GPUI Omarchy component gallery running in WebAssembly" loading="lazy" allow="clipboard-read; clipboard-write"></iframe>
        <p class="gallery-caption">The Rust gallery, running in your browser with WebAssembly. <a class="text-link" href={asset('gallery/index.html')} target="_blank" rel="noopener">Open gallery ↗</a> · <a class="text-link" href={`${repo}/tree/feat/omarchy-components-gallery/examples/gallery`}>View example source</a></p>
      </section>
      <section class="section split" id="foundation">
        <div><h2>Built on gpui-base.<br />Designed for Omarchy.</h2><p>Omarchy is more than a palette. It's the relationship between quiet surfaces, clear edges, and the work in front of you.</p><p>GPUI Omarchy demonstrates how far <a class="text-link" href="https://gpui-kit.com/base/">gpui-base</a> can go: shared behavior, freely customized presentation.</p></div>
        <dl class="principles">
          <div><dt><a href="https://gpui-kit.com/">GPUI Kit</a> — the foundation</dt><dd>A native Rust component ecosystem. GPUI Omarchy brings its building blocks into applications designed for the Omarchy desktop.</dd></div>
          <div><dt><a href="https://gpui-kit.com/base/">gpui-base</a> — freedom to customize</dt><dd>Shared state and interaction primitives, freely customized presentation. This library puts that freedom into practice with a complete visual language of its own.</dd></div>
          <div><dt><a href="https://github.com/huacnlee/omarchy-style">Omarchy Style</a> — the design language</dt><dd>Square geometry, outlined actions, and purposeful layouts. Reads the Omarchy system palette, with Tokyo Night as the fallback.</dd></div>
        </dl>
      </section>
      <section id="start" class="section split">
        <div><h2>Add to your application.</h2><p>Declare the dependencies, then create your first window. Initialization loads your Omarchy theme automatically.</p><div class="setup-command"><code>cargo add gpui-omarchy</code><CopyButton client:load text="cargo add gpui-omarchy" /></div><div class="code-frame"><div class="code-bar"><span>Cargo.toml</span><span>TOML</span></div><Code code={dependencies} lang="toml" themes={{light:'github-light',dark:'tokyo-night'}} defaultColor="dark" /></div><p class="text-sm mt-6">Save the example as src/main.rs and run <code>cargo run</code>.</p><a class="text-link" href={`${repo}#usage`}>Read the usage guide</a></div>
        <div class="code-frame"><div class="code-bar"><span>src/main.rs</span><span>Rust</span></div><Code code={quickStart} lang="rust" themes={{light:'github-light',dark:'tokyo-night'}} defaultColor="dark" /></div>
      </section>
    </main>
    <footer class="site-footer"><div class="shell"><span>GPUI Omarchy · An independent community project.</span><span>By <a class="text-link" href="https://github.com/huacnlee">Jason Lee</a> · <a class="text-link" href={`${repo}/blob/feat/omarchy-components-gallery/LICENSE`}>MIT license</a></span></div></footer>
  </body>
</html>
